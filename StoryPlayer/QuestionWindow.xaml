<Window x:Class="StoryPlayer.QuestionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoryPlayer"
        mc:Ignorable="d"
        Title="QuestionWindow" Height="450" Width="800" Topmost="True" Closing="OnClosing" SizeToContent="Height" ShowActivated="False">
    <DockPanel Background="{DynamicResource StoryPlayerBackground}">
        <RichTextBox x:Name="QuestionDocument" DockPanel.Dock="Top" MinHeight="100" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,40" AutoWordSelection="False" Focusable="False" IsHitTestVisible="False" FontFamily="{DynamicResource StoryPlayerCodeFont}" Margin="20,20,20,10" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Foreground="{DynamicResource StoryPlayerEditableText}">
            <FlowDocument/>
        </RichTextBox>
        <ProgressBar x:Name="TimeBar" DockPanel.Dock="Top" MinHeight="10" Margin="20,10,20,10" Foreground="{DynamicResource StoryPlayerProgressBarForeground}" Background="{DynamicResource StoryPlayerProgressBarBackground}"/>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" HorizontalAlignment="Center"/>
        <TextBox x:Name="AnswerTextBox" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="150" Margin="20,20,20,20" Padding="5,5,5,5" FontFamily="{DynamicResource StoryPlayerFont}" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" FontSize="{DynamicResource StoryPlayerFontSize}"/>
    </DockPanel>
</Window>
