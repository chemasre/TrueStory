<Window x:Class="StoryPlayer.LLMWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StoryPlayer"
        mc:Ignorable="d"
        Title="Consulta IA" Height="936" Width="800" Background="{DynamicResource StoryPlayerBackground}" ShowActivated="False">
    <DockPanel>
        <TextBox x:Name="ChatText" DockPanel.Dock="Top" MinHeight="500" IsReadOnly="True" Padding="20,20,20,40" FontFamily="{DynamicResource StoryPlayerCodeFont}" Margin="20,20,20,20" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
    </DockPanel>
</Window>
