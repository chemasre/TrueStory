<Window x:Class="ActivityDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ActivityDesigner"
        mc:Ignorable="d"
        Title="MainWindow" Width="836" Background="{DynamicResource StoryPlayerBackground}" Closing="OnClosing">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{DynamicResource StoryPlayerMenu}" FontFamily="{DynamicResource StoryPlayerFont}" FontSize="{DynamicResource StoryPlayerFontSize}" Foreground="{DynamicResource StoryPlayerMenuText}">
            <MenuItem x:Name="FileMenu" Header="Fichero" Background="{DynamicResource StoryPlayerMenu}" Padding="{DynamicResource StoryPlayerTabItemPadding}">
                <MenuItem x:Name="NewActivityMenuAction" Header="Nueva actividad" Click="OnMenuNewActivity"/>
                <MenuItem x:Name="OpenActivityMenuAction" Header="Abrir actividad..." Click="OnMenuOpenActivity"/>
                <MenuItem x:Name="SaveActivityMenuAction" Header="Guardar actividad" Click="OnMenuSaveActivity"/>
                <MenuItem x:Name="SaveActivityAsMenuAction" Header="Guardar actividad como..." Click="OnMenuSaveActivityAs"/>
                <MenuItem x:Name="ExitMenuAction" Header="Salir" Click="OnExitMenuAction"/>
            </MenuItem>
            <MenuItem x:Name="AboutMenu" Header="Acerca de" Background="{DynamicResource StoryPlayerMenu}" Padding="{DynamicResource StoryPlayerTabItemPadding}">
                <MenuItem x:Name="AboutMenuAction" Header="Acerca de StoryPlayer"/>
            </MenuItem>
        </Menu>
        <TabControl x:Name="Tabs" DockPanel.Dock="Top" Background="{DynamicResource StoryPlayerNonEditableTextBackground}">
            <TabItem x:Name="GeneralTab" Header="Configuración básica" Padding="8,5,8,5" Margin="0,0,0,0">
                <Grid Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Margin="20,20,20,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Label x:Name="GeneralLabel" Content="Configuración general de la actividad" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerPanelTitleText}" Grid.ColumnSpan="3" Background="{DynamicResource StoryPlayerPanelTitle}"/>
                    <Label x:Name="TitleLabel" Content="Título de la actividad" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="1" Margin="0,10,0,0"/>
                    <TextBox x:Name="TitleText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.ColumnSpan="2" Grid.Row="1" TextChanged="OnTitleChanged" Margin="0,10,0,0"/>
                    <Label x:Name="EditableExtensionsLabel" Content="Extensiones de fichero editables (separar con comas)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="2"/>
                    <TextBox x:Name="EditableExtensionsText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.ColumnSpan="2" Grid.Row="2" TextChanged="OnEditableExtensionsChanged"/>
                    <Label x:Name="QuestionsEnabledLabel" Content="Hacer preguntas durante la actividad" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="4" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="QuestionsEnabledCheckbox" Content="" Padding="{DynamicResource StoryPlayerTabItemPadding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsChecked="True" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Checked="OnQuestionsChecked" Unchecked="OnQuestionsUnchecked"/>
                    <DockPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,0,0,6">
                        <Button x:Name="QuestionsWaitProfileLoad" DockPanel.Dock="Right"  Content="Guardar esperas" MinWidth="100" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" Click="OnDeleteTemplate" Margin="0,10,0,0"/>
                        <Button x:Name="QuestionsWaitProfileSave" DockPanel.Dock="Right" Content="Cargar esperas" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" MinWidth="100" Click="OnCreateTemplate" Margin="0,10,0,0"/>
                        <Label x:Name="QuestionsWaitLabel"   Content="Esperas entre preguntas" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerPanelTitleText}" Background="{DynamicResource StoryPlayerPanelTitle}" Margin="20,10,0,0"/>
                    </DockPanel>
                    <Label x:Name="QuestionsTimeMinLabel" Content="Esperar a que pase un tiempo mínimo (segundos) entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="7" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsTimeMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="7" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsTimeMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="7" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="QuestionsTextMinLabel" Content="Esperar a que se introduzcan un mínimo de carácteres entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="8" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsTextMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="8" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsTextMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="8" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="QuestionsSavesMinLabel" Content="Esperar a que se guarden ficheros un mínimo de veces entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="9" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsSavesMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="9" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsSavesMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="9" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="QuestionsOpensMinLabel" Content="Esperar a que se abran ficheros un mínimo de veces entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="10" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsOpensMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="10" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsOpensMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="10" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="QuestionsCommandsMinLabel" Content="Esperar a que se ejecuten un mínimo de comandos entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="11" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsCommandsMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="11" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsCommandsMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="11" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="QuestionsObserveLabel" Content="Preguntar sobre un intervalo anterior de tiempo (segundos) entre" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="12" HorizontalAlignment="Left" Margin="20,0,0,0"/>
                    <TextBox x:Name="QuestionsObserveMinText" TextWrapping="Wrap" Grid.Column="1" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="12" Margin="0,0,5,0" TextChanged="OnQuestionParamChanged"/>
                    <TextBox x:Name="QuestionsObserveMaxText" TextWrapping="Wrap" Grid.Column="2" VerticalContentAlignment="Center" Padding="5,0,0,0" Grid.Row="12" TextChanged="OnQuestionParamChanged"/>
                    <Label x:Name="ConsoleEnabledLabel" Content="Habilitar consola de comandos durante la actividad" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" Grid.Row="3" HorizontalAlignment="Left"/>
                    <CheckBox x:Name="ConsoleEnabledCheckbox" Content="" Padding="{DynamicResource StoryPlayerTabItemPadding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsChecked="True" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Checked="OnConsoleChecked" Unchecked="OnConsoleUnchecked"/>
                </Grid>
            </TabItem>
            <TabItem x:Name="QuestionsTab" Header="Configuración de preguntas" Margin="0,0,0,0" Padding="8,5,8,5">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Margin="20,20,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.ColumnSpan="2">
                            <Button x:Name="QuestionTemplatesProfileLoad" DockPanel.Dock="Right"  Content="Guardar plantillas" MinWidth="100" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" Click="OnDeleteTemplate"/>
                            <Button x:Name="QuestionTemplatesProfileSave" DockPanel.Dock="Right" Content="Cargar plantillas" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" MinWidth="100" Click="OnCreateTemplate"/>
                            <Label x:Name="TemplatesLabel" DockPanel.Dock="Left" Content="Plantillas de pregunta" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerPanelTitleText}" Background="{DynamicResource StoryPlayerPanelTitle}"/>
                        </DockPanel>
                        <DockPanel Grid.Row="1" Grid.ColumnSpan="3">
                            <Button x:Name="TemplatesDelete" DockPanel.Dock="Right"  Content="Eliminar" MinWidth="100" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" Width="100" Click="OnDeleteTemplate" Margin="0,10,0,0"/>
                            <Button x:Name="TemplatesCreate" DockPanel.Dock="Right" Content="Crear" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" MinWidth="100" Width="100" Click="OnCreateTemplate" Margin="0,10,0,0"/>
                            <ComboBox x:Name="TemplatesList" DockPanel.Dock="Left" SelectionChanged="OnSelectedTemplateChanged" Margin="20,10,0,0"/>
                        </DockPanel>
                        <Label x:Name="QuestionTypeLabel" Content="Tema de la pregunta" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" Margin="40,10,0,0"/>
                        <ComboBox x:Name="QuestionTypeList" Grid.Row="2" Grid.Column="1" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="OnTemplateParamChanged" Margin="0,10,0,0">
                            <ComboBoxItem Content="Texto introducido recientemente"/>
                            <ComboBoxItem Content="Pregunta general sobre la actividad"/>
                            <ComboBoxItem Content="Fichero guardado recientemente"/>
                            <ComboBoxItem Content="Fichero abierto recientemente"/>
                            <ComboBoxItem Content="Comando introducido recientemente en la consola"/>
                        </ComboBox>
                        <Label x:Name="QuestionTextLabel" Content="Texto de la pregunta" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="3" Margin="40,0,0,0"/>
                        <TextBox x:Name="QuestionTextText" TextWrapping="Wrap" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" VerticalContentAlignment="Center" TextChanged="OnTemplateParamChanged"/>
                        <Label x:Name="QuestionTimeLabel" Content="Tiempo para contestar (segundos)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="4" Margin="40,0,0,0"/>
                        <TextBox x:Name="QuestionTimeText" TextWrapping="Wrap" Grid.Row="4" Grid.Column="2" VerticalContentAlignment="Center" TextChanged="OnTemplateParamChanged"/>
                        <Label x:Name="QuestionLinesLabel" Content="Líneas anteriores/posteriores que se muestran" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="5" Margin="40,0,0,0"/>
                        <TextBox x:Name="QuestionLinesText" TextWrapping="Wrap" Grid.Row="5" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnTemplateParamChanged"/>
                        <Label x:Name="QuestionWordsLabel" Content="Cantidad de palabras mínima en la línea" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="6" Margin="40,0,0,0"/>
                        <TextBox x:Name="QuestionWordsText" TextWrapping="Wrap" Grid.Row="6" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnTemplateParamChanged"/>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Margin="20,20,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="ProbabilityTextLabel" Content="Texto introducido recientemente (peso)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="8" Margin="20,10,0,0"/>
                        <TextBox x:Name="ProbabilityTextText" TextWrapping="Wrap" Grid.Row="8" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnProbabilityParamsChanged" Margin="0,10,0,0"/>
                        <Label x:Name="ProbabilityGeneralLabel" Content="Preguntas generales sobre la actividad (peso)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="9" Margin="20,0,0,0"/>
                        <TextBox x:Name="ProbabilityGeneralText" TextWrapping="Wrap" Grid.Row="9" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnProbabilityParamsChanged"/>
                        <Label x:Name="ProbabilitySavesLabel" Content="Ficheros guardados recientemente  (peso)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="10" Margin="20,0,0,0"/>
                        <TextBox x:Name="ProbabilitySavesText" TextWrapping="Wrap" Grid.Row="10" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnProbabilityParamsChanged"/>
                        <Label x:Name="ProbabilityOpensLabel" Content="Ficheros abiertos recientemente  (peso)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="11" Margin="20,0,0,0"/>
                        <TextBox x:Name="ProbabilityOpensText" TextWrapping="Wrap" Grid.Row="11" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnProbabilityParamsChanged"/>
                        <Label x:Name="ProbabilityCommandsLabel" Content="Comandos de consola recientes (peso)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="12" Margin="20,0,0,0"/>
                        <TextBox x:Name="ProbabilityCommandsText" TextWrapping="Wrap" Grid.Row="12" Grid.Column="1" VerticalContentAlignment="Center" TextChanged="OnProbabilityParamsChanged"/>
                        <DockPanel Grid.ColumnSpan="2">
                            <Button x:Name="QuestionChancesProfileLoad" DockPanel.Dock="Right"  Content="Guardar ajustes" MinWidth="100" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" Click="OnDeleteTemplate"/>
                            <Button x:Name="QuestionChancesProfileSave" DockPanel.Dock="Right" Content="Cargar ajustes" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" MinWidth="100" Click="OnCreateTemplate"/>
                            <Label x:Name="ProbabilityLabel" DockPanel.Dock="Left" Content="Proporción de preguntas por tema" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerPanelTitleText}" Background="{DynamicResource StoryPlayerPanelTitle}"/>
                        </DockPanel>
                    </Grid>
                    <Grid DockPanel.Dock="Top" Background="{DynamicResource StoryPlayerNonEditableTextBackground}" Margin="20,0,20,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Label x:Name="WordSeparatorsExtensionTextLabel" Content="Extensión de fichero" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="1" Margin="20,10,0,0"/>
                        <TextBox x:Name="WordSeparatorsText" TextWrapping="Wrap" VerticalContentAlignment="Center" Grid.Column="1" Grid.Row="2" Margin="0,10,0,0" TextChanged="OnSeparatorParamsChanged"/>
                        <ComboBox x:Name="WordSeparatorsExtensionList" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="OnSelectedExtensionChanged" Margin="0,10,0,0"/>
                        <Label x:Name="WordSeparatorsLabel" Content="Separadores (carácteres)" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerNonEditableText}" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Grid.Row="2" Margin="40,10,0,0"/>
                        <DockPanel Grid.ColumnSpan="2">
                            <Button x:Name="WordSeparatorsProfileLoad" DockPanel.Dock="Right"  Content="Guardar" MinWidth="100" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" Click="OnDeleteTemplate"/>
                            <Button x:Name="WordSeparatorsProfileSave" DockPanel.Dock="Right" Content="Cargar" Background="{DynamicResource StoryPlayerButtonNeutral}" Foreground="{DynamicResource StoryPlayerButtonsText}" Padding="0,0,0,0" MinWidth="100" Click="OnCreateTemplate"/>
                            <Label x:Name="WordSeparatorsTitleLabel" DockPanel.Dock="Left" Content="Separadores de palabras por extensiones" MinHeight="21" FontFamily="{DynamicResource StoryPlayerFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource StoryPlayerPanelTitleText}" Background="{DynamicResource StoryPlayerPanelTitle}"/>
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
