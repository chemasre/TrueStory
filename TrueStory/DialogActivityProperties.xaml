<Window x:Class="TrueStory.DialogActivityProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d" Height="300" Width="559" ResizeMode="NoResize" Title="Nueva actividad" Closing="Window_Closing" WindowStartupLocation="CenterOwner" Background="{DynamicResource TrueEditorBackground}" SizeToContent="Height" FontFamily="{DynamicResource TrueStoryFont}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="UseActivityFileRadio" Content="Usar fichero de configuración" Grid.ColumnSpan="2" Foreground="{DynamicResource TrueStoryNonEditableText}" Padding="5,5,5,5" VerticalContentAlignment="Center" Grid.Row="3" Checked="UseActivityFileRadio_Checked" Unchecked="UseActivityFileRadio_Unchecked" Margin="5,0,0,0"/>
            <Label x:Name="ActivityFileLabel" Grid.Row="5" Grid.Column="0" Content="Fichero de configuración" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}" FontFamily="{DynamicResource TrueStoryFont}" Padding="20,5,5,5"/>
            <DockPanel x:Name="ActivityFileDock" Grid.Row="5" Grid.Column="1" Margin="5,5,5,5">
                <Button x:Name="PickActivityFileButton" DockPanel.Dock="Right" Content="..."   MinWidth="30" Margin="5,0,0,0" Click="PickActivityFileButton_Click" Background="#FF7CE1FB" Foreground="{DynamicResource TrueStoryButtonsText}"/>
                <TextBox x:Name="ActivityFileText" DockPanel.Dock="Left" MaxLines="1" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            </DockPanel>
            <RadioButton x:Name="DontUseActivityFileRadio" Content="No usar fichero de configuración" Grid.ColumnSpan="2" Foreground="{DynamicResource TrueStoryNonEditableText}" Padding="5,5,5,5" VerticalContentAlignment="Center" IsChecked="True" Checked="DontUseActivityFileRadio_Checked" Unchecked="DontUseActivityFileRadio_Unchecked" Margin="5,0,0,0"/>
            <Label x:Name="ActivityTitleLabel" Grid.Row="1" Grid.Column="0" Content="Título de la actividad" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}" FontFamily="{DynamicResource TrueStoryFont}" Padding="20,5,5,5"/>
            <TextBox x:Name="ActivityTitleText" Grid.Row ="1"  Grid.Column="1" Text="Nombre" MaxLines="1" Margin="5,5,5,5" SelectionTextBrush="{DynamicResource TrueEditorEditableTextBackground}" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            <Label x:Name="StudentNameLabel" Grid.Row="6" Grid.Column="0" Content="Nombre y apellidos del alumno/a" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <TextBox x:Name="StudentNameText" Grid.Row ="6"  Grid.Column="1" Text="Nombre" MaxLines="1" Margin="5,5,5,5" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            <Label x:Name="ActivityFolderLabel" Grid.Row="7" Grid.Column="0" Content="Crear la actividad en esta carpeta" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <DockPanel x:Name="ActivityFolderDock" Grid.Row="7" Grid.Column="2" Margin="5,5,5,5">
                <Button x:Name="PickActivityFolderButton" DockPanel.Dock="Right" Content="..."   MinWidth="30" Margin="5,0,0,0" Click="PickActivityFolderButton_Click" Background="#FF7CE1FB" Foreground="{DynamicResource TrueStoryButtonsText}"/>
                <TextBox x:Name="ActivityFolderText" DockPanel.Dock="Left" MaxLines="1" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            </DockPanel>
            <Label x:Name="ActivityExtensionsLabel" Grid.Row="2" Grid.Column="0" Content="Extensiones editables (separa con comas)" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}" FontFamily="{DynamicResource TrueStoryFont}" Padding="20,5,5,5"/>
            <TextBox x:Name="ActivityExtensionsText" Grid.Row ="2"  Grid.Column="1" MaxLines="1" Margin="5,5,5,5" SelectionTextBrush="{DynamicResource TrueEditorEditableTextBackground}" Background="{DynamicResource TrueEditorEditableTextBackground}" TextChanged="OnExtensionsChanged"/>
        </Grid>
        <DockPanel HorizontalAlignment="Center" LastChildFill="False">
            <Button x:Name="Accept"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" Click="Accept_Click" Background="{DynamicResource TrueEditorButtonAccept}" MinHeight="50"/>
            <Button x:Name="Cancel" Content="Cancelar" MinWidth="100" Margin="10,10,10,10" Click="Cancel_Click" Background="{DynamicResource TrueEditorButtonCancel}" MinHeight="50"/>
        </DockPanel>
    </DockPanel>
</Window>
