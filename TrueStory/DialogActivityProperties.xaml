<Window x:Class="TrueStory.DialogActivityProperties"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d" Height="202" Width="440" ResizeMode="NoResize" Title="Nueva actividad" Closing="Window_Closing" WindowStartupLocation="CenterOwner" Background="{DynamicResource TrueEditorBackground}" SizeToContent="Height" FontFamily="{DynamicResource TrueStoryFont}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Label Grid.Row="0" Grid.Column="0" Content="Código (público) de actividad" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <TextBox x:Name="ActivityCodeText" Grid.Row ="0"  Grid.Column="1" Text="Nombre" MaxLines="1" Margin="5,5,5,5" SelectionTextBrush="{DynamicResource TrueEditorEditableTextBackground}" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            <Label Grid.Row="1" Grid.Column="0" Content="Nombre y apellidos del alumno/a" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <TextBox x:Name="StudentNameText" Grid.Row ="1"  Grid.Column="1" Text="Nombre" MaxLines="1" Margin="5,5,5,5" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            <Label Grid.Row="2" Grid.Column="0" Content="Carpeta de actividad" MinWidth="200" Margin="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <DockPanel Grid.Row="2" Grid.Column="2" Margin="5,5,5,5">
                <Button x:Name="PickActivityFolderButton" DockPanel.Dock="Right" Content="..."   MinWidth="30" Margin="5,0,0,0" Click="PickActivityFolderButton_Click" Background="#FF7CE1FB" Foreground="{DynamicResource TrueStoryButtonsText}"/>
                <TextBox x:Name="ActivityFolderText" DockPanel.Dock="Left" Text="Nombre" MaxLines="1" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
            </DockPanel>
        </Grid>
        <DockPanel LastChildFill="False" HorizontalAlignment="Center">
            <Button x:Name="Accept"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" Click="Accept_Click" Background="{DynamicResource TrueEditorButtonAccept}" MinHeight="50"/>
            <Button x:Name="Cancel" Content="Cancelar" MinWidth="100" Margin="10,10,10,10" Click="Cancel_Click" Background="{DynamicResource TrueEditorButtonCancel}" MinHeight="50"/>
        </DockPanel>
    </DockPanel>
</Window>
