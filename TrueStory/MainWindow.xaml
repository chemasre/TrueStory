<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Class="TrueStory.MainWindow"
        mc:Ignorable="d"
        Title="TrueStory 0.1.0" Height="640" Width="960" MinWidth="400" MinHeight="300" Background="{DynamicResource TrueEditorBackground}" Closed="OnWindowClosed">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="{DynamicResource TrueEditorMenu}" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}" Foreground="{DynamicResource TrueStoryMenuText}">
            <MenuItem x:Name="ActivityMenu" Header="Actividad" Background="{DynamicResource TrueEditorMenu}" Padding="{DynamicResource TrueStoryTabItemPadding}" BorderThickness="0,0,0,0">
                <MenuItem x:Name="NewActivityMenuAction" Header="Nueva actividad..." Click="OnNewActivity"/>
                <MenuItem x:Name="OpenActivityMenuAction" Header="Abrir actividad..." Click="OnMenuOpenActivity"/>
                <MenuItem x:Name="CloseActivityMenuAction" Header="Cerrar actividad" Click="OnMenuCloseActivity"/>
            </MenuItem>
            <MenuItem x:Name="FileMenu" Header="Archivo" Background="{DynamicResource TrueEditorMenu}" Padding="{DynamicResource TrueStoryTabItemPadding}" BorderThickness="0,0,0,0">
                <MenuItem x:Name="NewMenu" Header="Nuevo">
                    <MenuItem x:Name="NewFolderMenuAction" Header="Carpeta" Click="OnMenuNewFolder"/>
                    <MenuItem x:Name="NewFileMenuAction" Header="Fichero" Click="OnMenuNewFile" InputGestureText="Ctrl+N"/>
                </MenuItem>
                <MenuItem x:Name="RenameFileOrFolderMenuAction" Header="Cambiar nombre" Click="OnMenuRenameFileOrFolder"/>
                <MenuItem x:Name="DeleteFileOrFolderMenuAction" Header="Eliminar" Click="OnMenuDeleteFileOrFolder"/>
                <MenuItem x:Name="SaveFileMenuAction" Header="Guardar" Click="OnMenuSaveFile" InputGestureText="Ctrl+S"/>
            </MenuItem>
            <MenuItem x:Name="EditMenu" Header="Edición" Background="{DynamicResource TrueEditorMenu}" Padding="{DynamicResource TrueStoryTabItemPadding}" BorderThickness="0,0,0,0">
                <MenuItem x:Name="CutMenuAction" Header="Cortar" InputGestureText="Ctrl+X"/>
                <MenuItem x:Name="CopyMenuAction" Header="Copiar" InputGestureText="Ctrl+C"/>
                <MenuItem x:Name="PasteMenuAction" Header="Pegar" InputGestureText="Ctrl+V"/>
                <Separator/>
                <MenuItem x:Name="FindMenuAction" Header="Buscar..." InputGestureText="Ctrl+F"/>
                <MenuItem x:Name="GotoLineMenuAction" Header="Ir a línea..." InputGestureText="Ctrl+G"/>
            </MenuItem>
            <MenuItem x:Name="ViewMenu" Header="Ver" Background="{DynamicResource TrueEditorMenu}" Padding="{DynamicResource TrueStoryTabItemPadding}" BorderThickness="0,0,0,0">
                <MenuItem x:Name="EnlargeTextAction" Header="Agrandar texto" InputGestureText="Ctrl +"/>
                <MenuItem x:Name="ReduceTextAction" Header="Reducir texto" InputGestureText="Ctrl -"/>
                <MenuItem x:Name="ResetTextAction" Header="Restablecer tamaño de texto"/>
                <Separator/>
                <MenuItem x:Name="DarkModeCheckableAction" Header="Tema oscuro" IsCheckable="True" Checked="OnMenuDarkModeChecked" Unchecked="OnMenuDarkModeUnchecked"/>
            </MenuItem>
            <MenuItem x:Name="AboutMenu" Header="Acerca de" Background="{DynamicResource TrueEditorMenu}" Padding="{DynamicResource TrueStoryTabItemPadding}" BorderThickness="0,0,0,0">
                <MenuItem x:Name="AboutMenuAction" Header="Acerca de TrueStory" Click="OnMenuAboutApp"/>
            </MenuItem>
        </Menu>
        <DockPanel LastChildFill="True" DockPanel.Dock="Right" MinWidth="200" Width="100">
            <TextBlock x:Name="InstructorTextBox" DockPanel.Dock="Bottom" TextWrapping="Wrap" MinHeight="146" Text="Question soon" TextAlignment="Center" Padding="0,60,0,0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TrueStoryNonEditableText}" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorNonEditableTextBackground}"/>
            <Label x:Name="FolderViewTitleLabel" DockPanel.Dock="Top" Content="Carpeta de actividad" MinHeight="21" FontFamily="{DynamicResource TrueStoryFont}" BorderThickness="1,1,1,1" BorderBrush="{DynamicResource TrueEditorBackground}" Background="{DynamicResource TrueEditorPanelTitle}" FontWeight="Bold" Foreground="{DynamicResource TrueStoryPanelTitleText}"/>
            <ListBox x:Name="FolderViewList" DockPanel.Dock="Top" d:ItemsSource="{d:SampleData ItemCount=5}" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueEditorBackground}" />
        </DockPanel>
        <TextBox x:Name="CommandConsoleTextBox" DockPanel.Dock="Bottom" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" AcceptsReturn="True" AcceptsTab="True" MinHeight="120" MaxHeight="120" Height="100" Background="{DynamicResource TrueEditorEditableTextBackground}" FontSize="{DynamicResource TrueStoryFontSize}" Foreground="{DynamicResource TrueStoryEditableText}" BorderBrush="{DynamicResource TrueEditorBackground}"/>
        <Label x:Name="CommandConsoleTitleLabel" DockPanel.Dock="Bottom" Content="Consola de comandos" MinHeight="21" FontFamily="{DynamicResource TrueStoryFont}" BorderThickness="1,1,1,1" BorderBrush="{DynamicResource TrueEditorBackground}" Background="{DynamicResource TrueEditorPanelTitle}" FontWeight="Bold" Foreground="{DynamicResource TrueStoryPanelTitleText}"/>
        <Label x:Name="FileEditorInfoBarLabel" DockPanel.Dock="Bottom" Content="Información" Width="auto" MinHeight="21" FontFamily="{DynamicResource TrueStoryFont}" BorderThickness="1,1,1,1" Foreground="{DynamicResource TrueStoryInfobarText}" Background="{DynamicResource TrueEditorNonEditableTextBackground}" FontSize="{DynamicResource TrueStoryFontSize}"/>
        <Label x:Name="FileEditorTitleLabel" DockPanel.Dock="Top" Content="Título" MinHeight="21" FontFamily="{DynamicResource TrueStoryFont}" BorderThickness="1,1,1,1" BorderBrush="{DynamicResource TrueEditorBackground}" Background="{DynamicResource TrueEditorPanelTitle}" FontWeight="Bold" Foreground="{DynamicResource TrueStoryPanelTitleText}"/>
        <TextBox FontSize="{DynamicResource TrueStoryFontSize}" x:Name="FileEditorTextBox" DockPanel.Dock="Left" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryCodeFont}" AcceptsReturn="True" AcceptsTab="True" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" BorderBrush="{DynamicResource TrueEditorBackground}">
            <TextBox.InputBindings>
                <KeyBinding Key="Y" Modifiers="Control" Command="NotACommand" />
                <KeyBinding Key="Z" Modifiers="Control" Command="NotACommand" />
                <KeyBinding Key="X" Modifiers="Control" Command="NotACommand" />
                <KeyBinding Key="C" Modifiers="Control" Command="NotACommand" />
                <KeyBinding Key="V" Modifiers="Control" Command="NotACommand" />
            </TextBox.InputBindings>
        </TextBox>
    </DockPanel>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutSaveFile}" Executed="OnShortcutSaveFile"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutNewFile}" Executed="OnShortcutNewFile"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutEnlargeText}" Executed="OnShortcutEnlargeText"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutReduceText}" Executed="OnShortcutReduceText"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutCopy}" Executed="OnShortcutCopy"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutCut}" Executed="OnShortcutCut"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutPaste}" Executed="OnShortcutPaste"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutGoto}" Executed="OnShortcutGoto"/>
        <CommandBinding Command="{x:Static local:MainWindow.ShortcutFind}" Executed="OnShortcutFind"/>
    </Window.CommandBindings>
</Window>
