<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        xmlns:System="clr-namespace:System;assembly=System.Runtime" x:Class="TrueStory.MainWindow"
        mc:Ignorable="d"
        Title="TrueStory 0.1.0" Height="450" Width="800">
    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top" VerticalAlignment="Top" HorizontalAlignment="Stretch">
            <MenuItem x:Name="ActivityMenu" Header="Actividad">
                <MenuItem x:Name="NewActivityMenuAction" Header="Nueva actividad..." Click="OnNewActivity"/>
                <MenuItem x:Name="OpenActivityMenuAction" Header="Abrir actividad..." Click="OnMenuOpenActivity"/>
                <MenuItem x:Name="CloseActivityMenuAction" Header="Cerrar actividad" Click="OnMenuCloseActivity"/>
            </MenuItem>
            <MenuItem x:Name="FileMenu" Header="Archivo">
                <MenuItem x:Name="NewMenu" Header="Nuevo">
                    <MenuItem x:Name="NewFolderMenuAction" Header="Carpeta" Click="OnMenuNewFolder"/>
                    <MenuItem x:Name="NewFileMenuAction" Header="Fichero" Click="OnMenuNewFile"/>
                </MenuItem>
                <MenuItem x:Name="DeleteFileOrFolderMenuAction" Header="Eliminar" Click="OnMenuDeleteFileOrFolder"/>
                <MenuItem x:Name="SaveFileMenuAction" Header="Guardar" Click="OnMenuSaveFile"/>
            </MenuItem>
            <MenuItem x:Name="AboutMenu" Header="Acerca de">
                <MenuItem x:Name="AboutMenuAction" Header="Acerca de TrueStory" Click="OnMenuAboutApp"/>
            </MenuItem>
        </Menu>
        <ListBox x:Name="FolderView" DockPanel.Dock="Right" d:ItemsSource="{d:SampleData ItemCount=5}" MinWidth="200"/>
        <TextBox x:Name="CommandConsoleTextBox" DockPanel.Dock="Bottom" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="5,5,5,5" FontFamily="Courier New" AcceptsReturn="True" AcceptsTab="True" MinHeight="120" MaxHeight="120"/>
        <TextBox x:Name="FileEditorTextBox" DockPanel.Dock="Left" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="5,5,5,5" FontFamily="Courier New" AcceptsReturn="True" AcceptsTab="True"/>
    </DockPanel>
</Window>
