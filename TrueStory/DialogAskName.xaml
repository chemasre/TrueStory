<Window x:Class="TrueStory.DialogAskName"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d"
        Title="Introducir nombre" Height="177" Width="400" ResizeMode="NoResize" Closing="Window_Closing" WindowStartupLocation="CenterOwner" Background="{DynamicResource TrueEditorBackground}" SizeToContent="Height" FontFamily="{DynamicResource TrueStoryFont}">
    <DockPanel>
        <TextBlock x:Name="Message" DockPanel.Dock="Top" TextWrapping="Wrap" Text="Mensaje" MinHeight="50" Padding="5,5,5,5" Foreground="{DynamicResource TrueStoryNonEditableText}" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Margin="10,10,10,10"/>
        <TextBox x:Name="Input" DockPanel.Dock="Top" TextWrapping="Wrap" Text="Nombre" Margin="10,10,10,10" MaxLines="1" Height="21" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
        <DockPanel LastChildFill="False" HorizontalAlignment="Center">
            <Button x:Name="Accept"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" Click="Accept_Click" Background="{DynamicResource TrueEditorButtonAccept}" Foreground="{DynamicResource TrueStoryButtonsText}" MinHeight="50"/>
            <Button x:Name="Cancel" Content="Cancelar" MinWidth="100" Margin="10,10,10,10" Click="Cancel_Click" Background="{DynamicResource TrueEditorButtonCancel}" Foreground="{DynamicResource TrueStoryButtonsText}" MinHeight="50"/>
        </DockPanel>
    </DockPanel>
</Window>
