<Window x:Class="TrueStory.DialogLLM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d"
        Title="Asistente" Width="600" SizeToContent="Height" Background="{DynamicResource TrueEditorWindowBackground}">
    <DockPanel>
        <TextBox x:Name="AnswerText" DockPanel.Dock="Top" MinHeight="500" IsReadOnly="True" Padding="20,20,20,40" FontFamily="{DynamicResource TrueStoryCodeFont}" Margin="20,20,20,10" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="500" TextWrapping="Wrap"/>
        <ProgressBar x:Name="WaitBar" DockPanel.Dock="Top" MinHeight="10" Margin="20,10,20,10" Foreground="#FF07C51B" Background="{DynamicResource TrueEditorNonEditableTextBackground}" IsIndeterminate="True"/>
        <Label x:Name="StatusLabel" Content="&lt;estado&gt;" DockPanel.Dock="Top" VerticalContentAlignment="Center" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}" Padding="5,0,5,0" Foreground="{DynamicResource TrueStoryNonEditableText}" Height="15.6" Margin="20,0,20,0" HorizontalContentAlignment="Center"/>
        <TextBox x:Name="InputText" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="100" Margin="20,20,20,5" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" VerticalScrollBarVisibility="Auto" AcceptsReturn="True" AcceptsTab="True" MaxHeight="100"/>
        <Label Content="Pulsa [ctrl + intro] para enviar el mensaje" DockPanel.Dock="Top" VerticalContentAlignment="Center" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}" Padding="5,0,5,0" Margin="20,0,0,20" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="SetApiKeyButton" DockPanel.Dock="Right" Content="..." Margin="10,10,20,5"  Background="{DynamicResource TrueEditorButtonNeutral}" Foreground="{DynamicResource TrueStoryButtonsText}" Padding="10,10,10,10" MinWidth="40" Click="OnSetApiKeyButtonClicked"/>
            <Label x:Name="ApiKeyLabel" Content="Clave de API Gemini" DockPanel.Dock="Left" Margin="20,10,10,5" VerticalContentAlignment="Center" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <TextBox x:Name="ApiKeyInputText" DockPanel.Dock="Left" TextWrapping="Wrap" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" Margin="20,10,10,5" IsReadOnly="True" VerticalContentAlignment="Center" IsEnabled="False" MaxLines="1"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Height="100" HorizontalAlignment="Center">
            <Button x:Name="Close"  Content="Cerrar" MinWidth="100" Margin="10,10,10,10" MinHeight="50" Background="{DynamicResource TrueEditorButtonAccept}" Foreground="{DynamicResource TrueStoryButtonsText}" Click="OnCloseButtonPressed"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" >
            <Button x:Name="SetURLButton" DockPanel.Dock="Right" Content="..." Margin="10,5,20,20"  Background="{DynamicResource TrueEditorButtonNeutral}" Foreground="{DynamicResource TrueStoryButtonsText}" Padding="10,10,10,10" MinWidth="40" Click="OnSetApiURLButtonClicked"/>
            <Label x:Name="URLLabel" Content="URL de API Gemini" DockPanel.Dock="Left" Margin="20,5,10,20" VerticalContentAlignment="Center" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}" Foreground="{DynamicResource TrueStoryNonEditableText}"/>
            <TextBox x:Name="URLInputText" DockPanel.Dock="Left" TextWrapping="Wrap" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" Margin="20,5,10,20" IsReadOnly="True" VerticalContentAlignment="Center" IsEnabled="False" MaxLines="1"/>
        </DockPanel>
    </DockPanel>
</Window>
