<Window x:Class="TrueStory.DialogLLM"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d"
        Title="Gemini" Width="1094" ResizeMode="NoResize" SizeToContent="Height" Background="{DynamicResource TrueEditorBackground}">
    <DockPanel>
        <TextBox x:Name="AnswerText" DockPanel.Dock="Top" MinHeight="500" IsReadOnly="True" Padding="20,20,20,40" FontFamily="{DynamicResource TrueStoryCodeFont}" Margin="20,20,20,10" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="500" TextWrapping="Wrap"/>
        <ProgressBar x:Name="WaitBar" DockPanel.Dock="Top" MinHeight="10" Margin="20,10,20,10" Foreground="#FF07C51B" Background="{DynamicResource TrueEditorNonEditableTextBackground}" IsIndeterminate="True"/>
        <TextBox x:Name="InputText" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="100" Margin="20,20,20,20" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}"/>
        <DockPanel DockPanel.Dock="Top">
            <Button x:Name="SetApiKeyButton" DockPanel.Dock="Right" Content="..." Margin="10,10,20,20"  Background="{DynamicResource TrueEditorButtonNeutral}" Foreground="{DynamicResource TrueStoryButtonsText}" Padding="10,10,10,10" MinWidth="40" Click="OnSetApiKeyButtonClicked"/>
            <Label x:Name="ApiKeyLabel" Content="Gemini API key" DockPanel.Dock="Left" Margin="20,10,10,20" VerticalContentAlignment="Center" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}"/>
            <TextBox x:Name="ApiKeyInputText" DockPanel.Dock="Left" TextWrapping="Wrap" Padding="5,5,5,5" FontFamily="{DynamicResource TrueStoryFont}" Background="{DynamicResource TrueEditorEditableTextBackground}" Foreground="{DynamicResource TrueStoryEditableText}" Margin="20,10,10,20" IsReadOnly="True" VerticalContentAlignment="Center" IsEnabled="False"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" Height="100" HorizontalAlignment="Center">
            <Button x:Name="Close"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" MinHeight="50" Background="{DynamicResource TrueEditorButtonAccept}" Foreground="{DynamicResource TrueStoryButtonsText}"/>
        </DockPanel>
    </DockPanel>
</Window>
