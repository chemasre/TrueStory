             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrueStory"
             StartupUri="MainWindow.xaml"
    xmlns:System="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonNeutral" Color="#FF0F1C1F"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonAccept" Color="#FF152B1A"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonCancel" Color="#FF192223"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorBackground" Color="#FF161B17"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorEditableTextBackground" Color="#FF181916"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorNonEditableTextBackground" Color="#FF24271F"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryMenuText" Color="#FFBAEF0A"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorPanelTitle" Color="#FF1B231C"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorMenu" Color="#FF23231A"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryPanelTitleText" Color="#FFD8EFC8"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryInfobarText" Color="#FFB4F581"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryNonEditableText" Color="#FFCDECA0"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryButtonsText" Color="#FF93EAB6"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryTabItem" Color="#FF363731"/>
