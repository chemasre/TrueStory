<Application x:Class="TrueStory.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrueStory"
             StartupUri="MainWindow.xaml"
    xmlns:System="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <SolidColorBrush x:Key="TrueEditorButtonNeutral" Color="#FF7CE1FB"/>
        <SolidColorBrush x:Key="TrueEditorButtonAccept" Color="#FFEFDE24"/>
        <SolidColorBrush x:Key="TrueEditorButtonCancel" Color="#FFF1CF70"/>
        <SolidColorBrush x:Key="TrueEditorBackground" Color="#FFF7A756"/>
        <SolidColorBrush x:Key="TrueEditorEditableTextBackground" Color="#FFFBF4DB"/>
        <SolidColorBrush x:Key="TrueEditorNonEditableTextBackground" Color="#FFF7CE91"/>
        <SolidColorBrush x:Key="TrueStoryMenuText" Color="#FF7B3A1C"/>
        <SolidColorBrush x:Key="TrueEditorPanelTitle" Color="#FFED9B35"/>
        <SolidColorBrush x:Key="TrueEditorMenu" Color="#FFF9E3A5"/>
        <SolidColorBrush x:Key="TrueStoryPanelTitleText" Color="#FF884D11"/>
        <System:Double x:Key="TrueStoryFontSize">12</System:Double>
        <Thickness x:Key="TrueStoryTabItemPadding">8,6,8,4</Thickness>
        <SolidColorBrush x:Key="TrueStoryInfobarText" Color="#FFAB5933"/>
        <SolidColorBrush x:Key="TrueStoryNonEditableText" Color="#FF964621"/>
        <SolidColorBrush x:Key="TrueStoryButtonsText" Color="#FF964621"/>
        <SolidColorBrush x:Key="TrueStoryTabItem" Color="#FFF9E3A5"/>
        <SolidColorBrush x:Key="TrueStoryTabItemText" Color="#FF7B3A1C"/>
        <SolidColorBrush x:Key="TrueStoryTabControlBackground" Color="#FFF5E1BC"/>
        <SolidColorBrush x:Key="TrueStoryEditableText" Color="#FF080605"/>
        <FontFamily x:Key="TrueStoryFont">pack://application:,,,/Resources/Fonts/#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="TrueStoryCodeFont">pack://application:,,,/Resources/Fonts/#IBM Plex Mono</FontFamily>
    </Application.Resources>
</Application>
