        <SolidColorBrush x:Key="DarkMode_TrueStoryEditableText" Color="#FFE6FFA6"/>

        <SolidColorBrush x:Key="LightMode_TrueEditorButtonNeutral" Color="#FF7CE1FB"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorButtonAccept" Color="#FF80FF9F"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorButtonCancel" Color="#FFBBFAFF"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorBackground" Color="#FFCEFFD8"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorEditableTextBackground" Color="#FFF3FBDB"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorNonEditableTextBackground" Color="#FFE2F7C4"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryMenuText" Color="#FF3E5003"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorPanelTitle" Color="#FFB4EDBD"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorMenu" Color="#FFF4F7B8"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryPanelTitleText" Color="#FF3D4438"/>
