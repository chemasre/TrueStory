<Application x:Class="TrueStory.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TrueStory"
             StartupUri="MainWindow.xaml"
    xmlns:System="clr-namespace:System;assembly=System.Runtime">
    <Application.Resources>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonNeutral" Color="#FF0D181B"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonAccept" Color="#FF13170A"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorButtonCancel" Color="#FF0B1515"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorBackground" Color="#FFE0E0E0"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorEditableTextBackground" Color="#FF181B17"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorNonEditableTextBackground" Color="#FF19140C"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryMenuText" Color="#FFF75F5F"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorPanelTitle" Color="#FF252012"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorMenu" Color="#FF2B2819"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryPanelTitleText" Color="#FFE2BEBE"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryInfobarText" Color="#FFE29F9F"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryNonEditableText" Color="#FFED6868"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryButtonsText" Color="#FFED5E58"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryTabItem" Color="#FF15100A"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryTabItemText" Color="#FFEDA45A"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryTabControlBackground" Color="#FF170D09"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryResizableBorder" Color="#FF423737"/>
        <SolidColorBrush x:Key="DarkMode_TrueStoryEditableText" Color="#FFB8EA97"/>
        <SolidColorBrush x:Key="DarkMode_TrueEditorWindowBackground" Color="#FF120C06"/>

        <SolidColorBrush x:Key="LightMode_TrueEditorButtonNeutral" Color="#FF7CE1FB"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorButtonAccept" Color="#FFCFFF6D"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorButtonCancel" Color="#FF8AFFFC"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorBackground" Color="#FF484848"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorEditableTextBackground" Color="#FFC6DEBE"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorNonEditableTextBackground" Color="#FFFFCD83"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryMenuText" Color="#FF1F0303"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorPanelTitle" Color="#FFFFDD80"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorMenu" Color="#FFFFF196"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryPanelTitleText" Color="#FF443838"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryInfobarText" Color="#FF503737"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryNonEditableText" Color="#FF9C4B4B"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryButtonsText" Color="#FF481B19"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryTabItem" Color="#FFFFC386"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryTabItemText" Color="#FF332313"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryTabControlBackground" Color="#FFFF966E"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryResizableBorder" Color="#FFFFB76D"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryEditableText" Color="#FF0B0E09"/>
        <SolidColorBrush x:Key="LightMode_TrueEditorWindowBackground"  Color="#FFF7AD53"/>

        <SolidColorBrush x:Key="TrueEditorButtonNeutral" Color="#FF7CE1FB"/>
        <SolidColorBrush x:Key="TrueEditorButtonAccept" Color="#FFCFFF6D"/>
        <SolidColorBrush x:Key="TrueEditorButtonCancel" Color="#FF8AFFFC"/>
        <SolidColorBrush x:Key="TrueEditorBackground" Color="#FF484848"/>
        <SolidColorBrush x:Key="TrueEditorEditableTextBackground" Color="#FFC6DEBE"/>
        <SolidColorBrush x:Key="TrueEditorNonEditableTextBackground" Color="#FFFFCD83"/>
        <SolidColorBrush x:Key="TrueStoryMenuText" Color="#FF1F0303"/>
        <SolidColorBrush x:Key="TrueEditorPanelTitle" Color="#FFFFDD80"/>
        <SolidColorBrush x:Key="TrueEditorMenu" Color="#FFFFF196"/>
        <SolidColorBrush x:Key="TrueStoryPanelTitleText" Color="#FF443838"/>
        <System:Double x:Key="TrueStoryFontSize">12</System:Double>
        <Thickness x:Key="TrueStoryTabItemPadding">8,6,8,4</Thickness>
        <SolidColorBrush x:Key="TrueStoryInfobarText" Color="#FF503737"/>
        <SolidColorBrush x:Key="TrueStoryNonEditableText" Color="#FF9C4B4B"/>
        <SolidColorBrush x:Key="TrueStoryButtonsText" Color="#FF481B19"/>
        <SolidColorBrush x:Key="TrueStoryTabItem" Color="#FFFFC386"/>
        <SolidColorBrush x:Key="TrueStoryTabItemText" Color="#FF332313"/>
        <SolidColorBrush x:Key="TrueStoryResizableBorder" Color="#FFFFB76D"/>
        <SolidColorBrush x:Key="TrueStoryTabControlBackground" Color="#FFFF966E"/>
        <SolidColorBrush x:Key="TrueStoryEditableText" Color="#FF0B0E09"/>
        <FontFamily x:Key="TrueStoryFont">pack://application:,,,/Resources/Fonts/#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="TrueStoryCodeFont">pack://application:,,,/Resources/Fonts/#IBM Plex Mono</FontFamily>
        <SolidColorBrush x:Key="TrueEditorWindowBackground" Color="#FFF7AD53"/>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource TrueEditorMenu}" />
            <Setter Property="BorderThickness" Value="0" />

        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource TrueEditorMenu}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style TargetType="Button" x:Key="RoundButton">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10" />
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="Label" x:Key="RoundPanelTitle">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10,10,0,0" />
                </Style>
            </Style.Resources>
        </Style>

        <Style TargetType="TabItem" x:Key="RoundTabItem">
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10,10,0,0" />
                </Style>
            </Style.Resources>
        </Style>

        <DropShadowEffect x:Key="DropShadow" BlurRadius="10" Opacity="0.6"/>

    </Application.Resources>
</Application>
