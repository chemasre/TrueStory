        <SolidColorBrush x:Key="LightMode_TrueStoryTabItem" Color="#FFE5E8D0"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryTabItemText" Color="#FF303A2D"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryTabControlBackground" Color="#FF91A28E"/>
        <SolidColorBrush x:Key="LightMode_TrueStoryEditableText" Color="#FF080605"/>

        <SolidColorBrush x:Key="TrueEditorButtonNeutral" Color="#FF7CE1FB"/>
        <SolidColorBrush x:Key="TrueEditorButtonAccept" Color="#FF80FF9F"/>
        <SolidColorBrush x:Key="TrueEditorButtonCancel" Color="#FFBBFAFF"/>
        <SolidColorBrush x:Key="TrueEditorBackground" Color="#FFCEFFD8"/>
        <SolidColorBrush x:Key="TrueEditorEditableTextBackground" Color="#FFF3FBDB"/>
        <SolidColorBrush x:Key="TrueEditorNonEditableTextBackground" Color="#FFE2F7C4"/>
        <SolidColorBrush x:Key="TrueStoryMenuText" Color="#FF3E5003"/>
