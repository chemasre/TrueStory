        <SolidColorBrush x:Key="TrueEditorMenu" Color="#FFF4F7B8"/>
        <SolidColorBrush x:Key="TrueStoryPanelTitleText" Color="#FF3D4438"/>
        <System:Double x:Key="TrueStoryFontSize">12</System:Double>
        <Thickness x:Key="TrueStoryTabItemPadding">8,6,8,4</Thickness>
        <SolidColorBrush x:Key="TrueStoryInfobarText" Color="#FF425037"/>
        <SolidColorBrush x:Key="TrueStoryNonEditableText" Color="#FF3B442E"/>
        <SolidColorBrush x:Key="TrueStoryButtonsText" Color="#FF213529"/>
        <SolidColorBrush x:Key="TrueStoryTabItem" Color="#FFE5E8D0"/>
        <SolidColorBrush x:Key="TrueStoryTabItemText" Color="#FF303A2D"/>
        <SolidColorBrush x:Key="TrueStoryTabControlBackground" Color="#FF91A28E"/>
        <SolidColorBrush x:Key="TrueStoryEditableText" Color="#FF080605"/>
        <FontFamily x:Key="TrueStoryFont">pack://application:,,,/Resources/Fonts/#IBM Plex Sans</FontFamily>
        <FontFamily x:Key="TrueStoryCodeFont">pack://application:,,,/Resources/Fonts/#IBM Plex Mono</FontFamily>

        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="{DynamicResource TrueEditorMenu}" />
            <Setter Property="BorderThickness" Value="0" />

        </Style>

        <Style TargetType="Menu">
            <Setter Property="Background" Value="{DynamicResource TrueEditorMenu}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

    </Application.Resources>
</Application>
