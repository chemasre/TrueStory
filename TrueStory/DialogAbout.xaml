<Window x:Class="TrueStory.DialogAbout"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d" Width="640" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" SizeToContent="Height" Title="Acerca de " Background="{DynamicResource TrueEditorWindowBackground}" FontFamily="{DynamicResource TrueStoryFont}" FontSize="{DynamicResource TrueStoryFontSize}">
    <Window.Resources>

    </Window.Resources>
    <DockPanel>
        <DockPanel DockPanel.Dock="Top">
            <RichTextBox x:Name="Document" DockPanel.Dock="Left" IsReadOnly="True" IsDocumentEnabled="True" Padding="5,50,5,5" BorderBrush="{x:Null}" BorderThickness="0,0,0,0" Width="150" Background="{x:Null}" Foreground="{DynamicResource TrueStoryNonEditableText}">
                <FlowDocument>
                    <Paragraph TextAlignment="Center">
                        <InlineUIContainer>
                            <Image Source="/AboutImage.png" Width="80" RenderOptions.BitmapScalingMode="HighQuality" Effect="{DynamicResource DropShadow}"/>
                        </InlineUIContainer>
                    </Paragraph>
                </FlowDocument>
            </RichTextBox>
            <TabControl Effect="{DynamicResource DropShadow}" DockPanel.Dock="Right" Margin="0,30,30,40" Background="{DynamicResource TrueStoryTabControlBackground}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}">
                <TabItem Header="Qué es" Padding="{DynamicResource TrueStoryTabItemPadding}" Background="{DynamicResource TrueStoryTabItem}" Foreground="{DynamicResource TrueStoryTabItemText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" Style="{DynamicResource RoundTabItem}">
                    <RichTextBox MinHeight="200" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,20" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" SelectionBrush="{x:Null}" IsHitTestVisible="False" IsTabStop="False">
                        <FlowDocument>
                            <Paragraph>
                                <Bold>
                                    <Run Text="TrueEditor"/>
                                </Bold>
                                es un editor de texto similar a un bloc de notas cuyo objetivo es
                                desincentivar que introduzcas contenido que no comprendes cuando realizas actividades escolares y proporcionar a tu profesor/a evidencias de que has hecho tú el trabajo. 
                            </Paragraph>
                            <Paragraph Padding="8,5,8,10" BorderThickness="1,1,1,1" BorderBrush="#FF236DBF" Foreground="#FF236DBF" FontWeight="Bold">
                                Recuerda que el objetivo de la educación es entrenar la red neuronal... que tienes en la cabeza.
                            </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="Cómo funciona" Padding="{DynamicResource TrueStoryTabItemPadding}" Background="{DynamicResource TrueStoryTabItem}" Foreground="{DynamicResource TrueStoryTabItemText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" Style="{DynamicResource RoundTabItem}">
                    <RichTextBox MinHeight="200" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,20" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" IsHitTestVisible="False" IsTabStop="False">
                        <FlowDocument>
                                    <Paragraph Margin="0,0,0,10">
                                        <Bold>
                                            <Run Text="Guarda un registro detallado de todas las acciones que haces dentro del programa"/>
                                        </Bold>. Por ejemplo, registra todas la modificaciones que haces a cualquiera de los ficheros, carácter a carácter.
                                    </Paragraph>
                                    <Paragraph >Además, 
                                <Bold>
                                    <Run Text="no permite que copies y pegues desde fuentes externas"/>
                                </Bold> . La aplicación dispone de su propio sistema de copia/pega, de forma que puedes copiar y pegar sólo entre documentos de la actividad.
                                    </Paragraph>
                                    <Paragraph>
                                Por último,
                                <Bold>
                                    <Run Text="puede hacerte preguntas cada cierto tiempo acerca del contenido introducido en los documentos"/>
                                </Bold>. Si las contestas mal repetidamente, puede ser un indicio de que estás introduciendo un contenido que no entiendes.
                                    </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="Qué no hace" Padding="{DynamicResource TrueStoryTabItemPadding}" Background="{DynamicResource TrueStoryTabItem}" Foreground="{DynamicResource TrueStoryTabItemText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" Style="{DynamicResource RoundTabItem}">
                    <RichTextBox MinHeight="200" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,20" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" SelectionBrush="{x:Null}" IsHitTestVisible="False" IsTabStop="False">
                        <FlowDocument>
                                    <Paragraph>La aplicación
                                <Bold>NO monitoriza tu ordenador de ninguna forma</Bold>. El editor no examina otras ventanas que tengas abiertas ni registra la actividad del teclado continuamente. Si quieres comprobarlo tienes su código disponible en GitHub</Paragraph>
                            <Paragraph>La aplicación
                                <Bold>NO te desincentiva a utilizar asistencia de IA</Bold>. De hecho incluye su propio asistente integrado que está, eso sí, configurado para ayudarte y no para darte las respuestas.
                            </Paragraph>
                                    <Paragraph>Finalmente,
                                <Bold>NO evita que &quot;hagas trampa&quot;</Bold>. Si te empeñas, puedes saltarte todos los controles que pone. Eso sí, perderás un tiempo en hacerlo que podrías invertir en formarte de verdad.
                                    </Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="Licencia" Padding="{DynamicResource TrueStoryTabItemPadding}" Background="{DynamicResource TrueStoryTabItem}" Foreground="{DynamicResource TrueStoryTabItemText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" Style="{DynamicResource RoundTabItem}">
                    <RichTextBox MinHeight="200" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,20" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" SelectionBrush="{x:Null}" IsHitTestVisible="False" IsTabStop="False">
                        <FlowDocument>
                            <Paragraph TextAlignment="Center" Margin="0,20,0,0">
                                <InlineUIContainer>
                                    <Image Source="/AboutLicense.png" Width="200" Margin="10,10,10,10" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </InlineUIContainer>
                            </Paragraph>
                            <Paragraph TextAlignment="Center" >© 2026 Sinestesia Game Design. Todos los derechos reservados.</Paragraph>
                            <Paragraph TextAlignment="Center" >
                                <Bold>Licencia para uso educativo válida durante el curso 2026/27.</Bold></Paragraph>

                        </FlowDocument>
                    </RichTextBox>
                </TabItem>
                <TabItem Header="Otras herramientas" Padding="{DynamicResource TrueStoryTabItemPadding}" Background="{DynamicResource TrueStoryTabItem}" Foreground="{DynamicResource TrueStoryTabItemText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" Style="{DynamicResource RoundTabItem}">
                    <RichTextBox MinHeight="200" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,20" Background="{DynamicResource TrueEditorNonEditableTextBackground}" Foreground="{DynamicResource TrueStoryNonEditableText}" BorderBrush="{DynamicResource TrueStoryTabControlBackground}" SelectionBrush="{x:Null}" IsHitTestVisible="False" IsTabStop="False">
                        <FlowDocument>
                            <Paragraph>
                                Otras herramientas pedagógicas desarrolladas por
                                <Bold>Sinestesia</Bold>:
                            </Paragraph>
                            <List>
                                <ListItem>
                                    <Paragraph>
                                        <Bold>MiniBoy Color</Bold>: una consola pedagógica.
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Bold>Data Trek: trade conflicts</Bold>, que gamifica retos de programación.
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Bold>Programabara</Bold>, un generador de programaciones didácticas.
                                    </Paragraph>
                                </ListItem>
                                <ListItem>
                                    <Paragraph>
                                        <Bold>Turtle Sandbox</Bold>, un entorno para enseñar programación a artistas.
                                    </Paragraph>
                                </ListItem>
                            </List>
                            <Paragraph Margin="0,30,0,0" TextAlignment="Left">
                                Para más información, visita <Bold>https://sinestesiagamedesign.es</Bold></Paragraph>
                        </FlowDocument>
                    </RichTextBox>
                </TabItem>
            </TabControl>
        </DockPanel>
        <DockPanel DockPanel.Dock="Top" LastChildFill="False" HorizontalAlignment="Center">
            <Button x:Name="Accept"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" Click="Accept_Click" MinHeight="50" Background="{DynamicResource TrueEditorButtonAccept}" Foreground="{DynamicResource TrueStoryButtonsText}" Style="{DynamicResource RoundButton}" Effect="{DynamicResource DropShadow}" />
        </DockPanel>
    </DockPanel>
</Window>
