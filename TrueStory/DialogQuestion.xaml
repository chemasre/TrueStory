<Window x:Class="TrueStory.DialogQuestion"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrueStory"
        mc:Ignorable="d"
        Title="Pregunta" Width="670" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" SizeToContent="Height" Background="{DynamicResource TrueEditorBackground}">
    <DockPanel>
        <RichTextBox x:Name="QuestionDocument" DockPanel.Dock="Top" MinHeight="100" IsReadOnly="True" IsDocumentEnabled="True" Padding="20,20,20,40" AutoWordSelection="False" Focusable="False" IsHitTestVisible="False" FontFamily="Consolas" Margin="20,20,20,10" Background="{DynamicResource TrueEditorNonEditableTextBackground}">
            <FlowDocument/>
        </RichTextBox>
        <ProgressBar x:Name="TimeBar" DockPanel.Dock="Top" MinHeight="10" Margin="20,10,20,10" Foreground="#FF07C51B"/>
        <DockPanel DockPanel.Dock="Bottom" LastChildFill="False" HorizontalAlignment="Center">
            <Button x:Name="Accept"  Content="Aceptar" MinWidth="100" Margin="10,10,10,10" Click="Accept_Click" MinHeight="50" Background="{DynamicResource TrueEditorButtonAccept}"/>
        </DockPanel>
        <TextBox x:Name="AnswerTextBox" DockPanel.Dock="Top" TextWrapping="Wrap" MinHeight="150" Margin="20,20,20,20" Padding="5,5,5,5" FontFamily="Courier New" Background="{DynamicResource TrueEditorEditableTextBackground}"/>
    </DockPanel>
</Window>
